#!/usr/bin/env python3
"""my-extras — keep track of Miles's extras on top of Artekka's kit (branch `miles` only, never sent).

The kit folder holds Artekka's kit (remote `upstream`) plus extras. Each extra is a branch
`extra/<id>` that starts from upstream/main and adds one feature or fix; `miles` is upstream plus the
merged extras plus this folder (my-extras/), and is the installed plugin. MY-EXTRAS.md (not in git)
lists the extras; this script keeps its table true.

Usage: my-extras <command>
  header   one line for the start word's menu: kit version, extras, ▲ when upstream has news,
           ⚠ when miles holds a change no extra owns. Fetches upstream at most once a day (2 s limit).
  news     what upstream changed since miles was built, and which extras need a refit
  status   the table, with live refit flags
  check    exit 1 (and list them) when miles has commits that belong to no extra
  refresh  fetch upstream and pull-request states now, and rewrite MY-EXTRAS.md's table
  files <id>   the files extra <id> changes
Env: MY_EXTRAS_REPO (default: this script's repo), MY_EXTRAS_UPSTREAM (default upstream/main),
     MY_EXTRAS_NO_NET=1 (never fetch or call gh; tests), MY_EXTRAS_GH_REPO (default Artekka/claude-orchestration-kit).
"""
import json, os, re, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
REPO = os.environ.get("MY_EXTRAS_REPO") or os.path.dirname(HERE)
UP = os.environ.get("MY_EXTRAS_UPSTREAM", "upstream/main")
NO_NET = os.environ.get("MY_EXTRAS_NO_NET") == "1"
GH_REPO = os.environ.get("MY_EXTRAS_GH_REPO", "Artekka/claude-orchestration-kit")
PAGE = os.path.join(REPO, "MY-EXTRAS.md")
TRACKING = ("my-extras/", "tests/my-extras.test.sh")   # this tool's own files: never an extra, never sent
STATUSES = ("Building", "Only mine", "Sent", "Changes asked", "Merged", "Turned down")
DAY = 24 * 3600


def git(*args, check=True):
    r = subprocess.run(["git", "-C", REPO, *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        raise SystemExit("my-extras: git %s failed: %s" % (" ".join(args), r.stderr.strip()))
    return r.stdout.strip()


def gitdir_file(name):
    return os.path.join(git("rev-parse", "--absolute-git-dir"), name)


def stamp_old(name):
    try:
        return time.time() - os.path.getmtime(gitdir_file(name)) > DAY
    except OSError:
        return True


def touch(name):
    with open(gitdir_file(name), "w") as f:
        f.write(str(int(time.time())))


def fetch(force=False):
    if NO_NET or not (force or stamp_old("my-extras-fetch")):
        return
    touch("my-extras-fetch")   # even when offline: try again tomorrow, never slow every start
    remote = UP.split("/")[0]
    subprocess.run(["timeout", "2", "git", "-C", REPO, "fetch", "-q", remote],
                   capture_output=True, text=True)


def version(ref):
    try:
        return json.loads(git("show", ref + ":.claude-plugin/plugin.json")).get("version", "?")
    except (SystemExit, ValueError):
        return "?"


def base():
    return git("merge-base", "miles", UP)


# ---- MY-EXTRAS.md: one "### <id>" block per extra with "- key: value" lines
def read_page():
    extras, cur, history = [], None, []
    if not os.path.exists(PAGE):
        return extras, history
    section = ""
    for line in open(PAGE, encoding="utf-8"):
        line = line.rstrip("\n")
        if line.startswith("## "):
            section = line[3:].strip().lower()
            cur = None
            continue
        if section.startswith("details") and line.startswith("### "):
            cur = {"id": line[4:].strip()}
            extras.append(cur)
            continue
        m = re.match(r"^- (\w+):\s*(.*)$", line)
        if cur is not None and m:
            cur[m.group(1)] = m.group(2).strip()
        elif section.startswith("given to his kit") and line.startswith("- "):
            history.append(line[2:])
    return extras, history


def extra_files(eid):
    br = "extra/" + eid
    if not git("rev-parse", "--verify", "-q", br, check=False):
        return []
    return [f for f in git("diff", "--name-only", UP + "..." + br).splitlines() if f]


def upstream_changed():
    return set(f for f in git("diff", "--name-only", base(), UP).splitlines() if f)


def needs_refit(eid, changed=None):
    changed = upstream_changed() if changed is None else changed
    return sorted(set(extra_files(eid)) & changed)


def stray_commits():
    """miles commits since the base that no extra branch holds and that touch more than this tool."""
    out = []
    for sha in git("rev-list", "--no-merges", base() + "..miles").splitlines():
        if git("branch", "--list", "extra/*", "--contains", sha):
            continue
        files = [f for f in git("show", "--name-only", "--format=", sha).splitlines() if f]
        if files and all(f.startswith(TRACKING) for f in files):
            continue
        out.append(sha[:7] + " " + git("show", "-s", "--format=%s", sha))
    return out


def gh_state(pr):
    if NO_NET or not pr.isdigit():
        return None
    r = subprocess.run(["timeout", "10", "gh", "pr", "view", pr, "--repo", GH_REPO, "--json", "state,reviewDecision"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    d = json.loads(r.stdout)
    if d.get("state") == "MERGED":
        return "Merged"
    if d.get("state") == "CLOSED":
        return "Turned down"
    return "Changes asked" if d.get("reviewDecision") == "CHANGES_REQUESTED" else "Sent"


def render(extras, history, changed):
    rows = ["| Extra | What it does | Status | Pull request |", "|---|---|---|---|"]
    for e in extras:
        st = e.get("status", "Only mine")
        if needs_refit(e["id"], changed):
            st += ", needs refit"
        pr = e.get("pr", "")
        prc = "#%s" % pr if pr.isdigit() else "—"
        rows.append("| %s | %s | %s | %s |" % (e.get("name", e["id"]), e.get("what", ""), st, prc))
    lines = [
        "# My extras",
        "",
        "Your additions on top of your friend's kit. Each one is kept separately (branch `extra/<id>`), so it",
        "can be sent to him on its own, or kept only for you. The table is rewritten by",
        "`my-extras/my-extras refresh` (the start word runs it once a day); edit the Details below, not the table.",
        "",
        "Kit: Orca-kit %s + your extras · his latest: %s · updated %s" % (version(base()), version(UP), time.strftime("%Y-%m-%d")),
        "",
    ] + rows + ["", "Statuses: " + " · ".join(STATUSES) + "; \"needs refit\" = his newer version changed files this extra uses.", "", "## Details", ""]
    for e in extras:
        lines.append("### " + e["id"])
        for k in ("name", "status", "pr", "what"):
            lines.append("- %s: %s" % (k, e.get(k, "")))
        lines.append("- files (from git): " + (" ".join(extra_files(e["id"])) or "(branch missing)"))
        lines.append("")
    lines += ["## Given to his kit", ""] + (["- " + h for h in history] or ["(none yet)"]) + [""]
    with open(PAGE, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))


def live(extras):
    return [e for e in extras if e.get("status") != "Merged"]


def in_kit(extras):
    return [e for e in extras if e.get("status") in ("Only mine", "Sent", "Changes asked")]


def warn(text):
    """Bold yellow, so a waiting update stands out in the menu; plain when NO_COLOR is set."""
    return text if os.environ.get("NO_COLOR") else "\033[1;33m%s\033[0m" % text


def good(text):
    """Green: the installed kit is his current one; plain when NO_COLOR is set."""
    return text if os.environ.get("NO_COLOR") else "\033[32m%s\033[0m" % text


def cmd_header():
    fetch()
    extras, _ = read_page()
    n = len(in_kit(extras))
    mine = version(base())
    line = "Orca-kit %s + %d extra%s   /   " % (mine, n, "" if n == 1 else "s")
    ahead = int(git("rev-list", "--count", "miles.." + UP) or 0)
    if ahead:
        nv = version(UP)
        line += warn("▲ current %s (news)" % nv if nv != mine else "▲ current %s + new changes (news)" % nv)
    else:
        line += good("current %s ✓" % mine)
    stray = stray_commits()
    if stray:
        line += "   " + warn("⚠ %d unlisted change%s" % (len(stray), "" if len(stray) == 1 else "s"))
    print(line)
    sys.stdout.flush()
    if stamp_old("my-extras-refresh") and not NO_NET:
        # pull-request states can take seconds: refresh the page in the background, never in the menu's way
        subprocess.Popen([os.path.realpath(__file__), "refresh"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_news():
    fetch()
    extras, _ = read_page()
    b = base()
    ahead = git("rev-list", "--count", "miles.." + UP)
    print("Installed: Orca-kit %s + %d extras.  His latest: %s (%s new commit%s)." %
          (version(b), len(in_kit(extras)), version(UP), ahead, "" if ahead == "1" else "s"))
    if ahead != "0":
        heads = [l[1:].strip() for l in git("diff", b, UP, "--", "CHANGELOG.md").splitlines()
                 if l.startswith("+## ") or l.startswith("+- **")]
        if heads:
            print("What's new (his CHANGELOG):")
            for h in heads[:15]:
                print("  " + re.sub(r"\*\*", "", h)[:150])
        changed = upstream_changed()
        print("Your extras:")
        for e in live(extras):
            hit = needs_refit(e["id"], changed)
            if hit:
                print("  %s needs a refit (he changed %s)" % (e.get("name", e["id"]), ", ".join(hit[:4])))
            else:
                print("  %s: not affected" % e.get("name", e["id"]))
        print('To update: ask Claude "update the kit".')
    else:
        print("Nothing new from him.")
    stray = stray_commits()
    if stray:
        print("⚠ Changes on miles that belong to no extra:")
        for s in stray:
            print("  " + s)


def cmd_status():
    extras, history = read_page()
    changed = upstream_changed()
    for e in extras:
        st = e.get("status", "")
        if needs_refit(e["id"], changed):
            st += ", needs refit"
        print("%-14s %-24s %s" % (e["id"], st, ("#" + e["pr"]) if e.get("pr", "").isdigit() else ""))
    for h in history:
        print("given: " + h)


def refresh(fetch_now=True):
    if fetch_now:
        fetch(force=True)
    extras, history = read_page()
    if not extras and not os.path.exists(PAGE):
        raise SystemExit("my-extras: no MY-EXTRAS.md in " + REPO)
    for e in extras:
        if e.get("status") in ("Sent", "Changes asked"):
            st = gh_state(e.get("pr", ""))
            if st == "Turned down":
                e["status"] = "Only mine"
                e["what"] = e.get("what", "") + " (he turned down #%s)" % e.get("pr")
                e["pr"] = ""
            elif st:
                e["status"] = st
    render(extras, history, upstream_changed())
    if not NO_NET:
        touch("my-extras-refresh")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "header":
        cmd_header()
    elif cmd == "news":
        cmd_news()
    elif cmd == "status":
        cmd_status()
    elif cmd == "check":
        stray = stray_commits()
        for s in stray:
            print("unlisted: " + s)
        sys.exit(1 if stray else 0)
    elif cmd == "refresh":
        refresh()
        print("MY-EXTRAS.md refreshed")
    elif cmd == "files" and len(sys.argv) > 2:
        print("\n".join(extra_files(sys.argv[2])))
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(64)


if __name__ == "__main__":
    main()
