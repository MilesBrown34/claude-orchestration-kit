#!/usr/bin/env python3
"""my-extras — keep track of PRS's extras on top of Artekka's kit (branch `prs` only, never sent).

The kit folder holds Artekka's kit (remote `upstream`) plus extras. Each extra is a branch
`extra/<id>` that starts from upstream/main and adds one feature or fix; `prs` is upstream plus the
merged extras plus this folder (my-extras/), and is the installed plugin. MY-EXTRAS.md (not in git)
lists the extras; this script keeps its table true.

Usage: my-extras <command>
  header   one line for the start word's menu: kit version, extras, ▲ when upstream has news,
           ⚠ when prs holds a change no extra owns. Fetches upstream at most once a day (2 s limit).
  news     what upstream changed since prs was built, and which extras need a refit
  status   the table, with live refit flags
  check    exit 1 (and list them) when prs has commits that belong to no extra
  refresh  fetch upstream and pull-request states now, and rewrite MY-EXTRAS.md's table
  files <id>   the files extra <id> changes
  release [--dry-run] [--minor|--major]   package prs as the official version a visitor downloads: refuses
           while upstream has new commits (update first), the tree is dirty, prs holds an unlisted change,
           prs is already released, or the gate (MY_EXTRAS_GATE, default `bash tests/run.sh`) is red; then
           tags prs with the kit's own version (v1.0.0 first; the last number bumps unless --minor/--major;
           Artekka's version goes in the title and notes), pushes prs,
           overwrites the fork's official branch (MY_EXTRAS_OFFICIAL, default main, with --force-with-lease),
           pushes the tag and makes a GitHub Release page on the fork (notes = the kit version and the extras'
           one-line descriptions, scanned by push-check first). Before the gate it rewrites the fork's own
           README blocks on branch extra/<MY_EXTRAS_README_EXTRA, default fork-readme> (the top block: version,
           Artekka's version, the extras table; the changelog block at the end: one entry per release) and
           merges that branch into prs.
Env: MY_EXTRAS_REPO (default: this script's repo), MY_EXTRAS_UPSTREAM (default upstream/main),
     MY_EXTRAS_ORIGIN (default origin: the fork), MY_EXTRAS_OFFICIAL (default main),
     MY_EXTRAS_NO_NET=1 (never fetch or call gh; tests), MY_EXTRAS_GH_REPO (default Artekka/claude-orchestration-kit).
"""
import json, os, re, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
REPO = os.environ.get("MY_EXTRAS_REPO") or os.path.dirname(HERE)
UP = os.environ.get("MY_EXTRAS_UPSTREAM", "upstream/main")
NO_NET = os.environ.get("MY_EXTRAS_NO_NET") == "1"
GH_REPO = os.environ.get("MY_EXTRAS_GH_REPO", "Artekka/claude-orchestration-kit")
ORIGIN = os.environ.get("MY_EXTRAS_ORIGIN", "origin")
OFFICIAL = os.environ.get("MY_EXTRAS_OFFICIAL", "main")
GATE = os.environ.get("MY_EXTRAS_GATE", "bash tests/run.sh")
README_EXTRA = os.environ.get("MY_EXTRAS_README_EXTRA", "fork-readme")
TOP_A, TOP_Z = "<!-- own-fork:top -->", "<!-- /own-fork:top -->"
LOG_A, LOG_Z = "<!-- own-fork:changelog -->", "<!-- /own-fork:changelog -->"
PAGE = os.path.join(REPO, "MY-EXTRAS.md")
TRACKING = ("my-extras/", "tests/my-extras.test.sh")   # this tool's own files: never an extra, never sent
STATUSES = ("Building", "Only mine", "Sent", "Changes asked", "Merged", "Turned down")
DAY = 24 * 3600


def git(*args, check=True):
    r = subprocess.run(["git", "-C", REPO, *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        raise SystemExit("my-extras: git %s failed: %s" % (" ".join(args), r.stderr.strip()))
    return r.stdout.strip()


def gitdir_file(name):
    return os.path.join(git("rev-parse", "--absolute-git-dir"), name)


def stamp_old(name):
    try:
        return time.time() - os.path.getmtime(gitdir_file(name)) > DAY
    except OSError:
        return True


def touch(name):
    with open(gitdir_file(name), "w") as f:
        f.write(str(int(time.time())))


def fetch(force=False):
    if NO_NET or not (force or stamp_old("my-extras-fetch")):
        return
    touch("my-extras-fetch")   # even when offline: try again tomorrow, never slow every start
    remote = UP.split("/")[0]
    subprocess.run(["timeout", "2", "git", "-C", REPO, "fetch", "-q", remote],
                   capture_output=True, text=True)


def version(ref):
    try:
        return json.loads(git("show", ref + ":.claude-plugin/plugin.json")).get("version", "?")
    except (SystemExit, ValueError):
        return "?"


def base():
    return git("merge-base", "prs", UP)


# ---- MY-EXTRAS.md: one "### <id>" block per extra with "- key: value" lines
def read_page():
    extras, cur, history = [], None, []
    if not os.path.exists(PAGE):
        return extras, history
    section = ""
    for line in open(PAGE, encoding="utf-8"):
        line = line.rstrip("\n")
        if line.startswith("## "):
            section = line[3:].strip().lower()
            cur = None
            continue
        if section.startswith("details") and line.startswith("### "):
            cur = {"id": line[4:].strip()}
            extras.append(cur)
            continue
        m = re.match(r"^- ([A-Za-z][\w ]*):\s*(.*)$", line)  # "files (from git)" is rebuilt, so never read
        if cur is not None and m:
            cur[m.group(1)] = m.group(2).strip()
        elif section.startswith("given to his kit") and line.startswith("- "):
            history.append(line[2:])
    return extras, history


def extra_files(eid):
    br = "extra/" + eid
    if not git("rev-parse", "--verify", "-q", br, check=False):
        return []
    return [f for f in git("diff", "--name-only", UP + "..." + br).splitlines() if f]


def upstream_changed():
    return set(f for f in git("diff", "--name-only", base(), UP).splitlines() if f)


def needs_refit(eid, changed=None):
    changed = upstream_changed() if changed is None else changed
    return sorted(set(extra_files(eid)) & changed)


def patch_id(sha):
    """The change itself, independent of its commit id (an amended or rebased copy has the same one)."""
    patch = subprocess.run(["git", "-C", REPO, "show", "--format=", sha], capture_output=True, text=True).stdout
    out = subprocess.run(["git", "-C", REPO, "patch-id", "--stable"], input=patch, capture_output=True, text=True).stdout
    return out.split()[0] if out.split() else None


def extra_patch_ids():
    ids = set()
    for br in git("for-each-ref", "--format=%(refname:short)", "refs/heads/extra/").splitlines():
        for sha in git("rev-list", "--no-merges", UP + ".." + br).splitlines():
            ids.add(patch_id(sha))
    return ids


def stray_commits():
    """prs commits since the base that no extra branch holds (by id, else by the change itself:
    an extra amended after its merge is the same change) and that touch more than this tool."""
    out, ids = [], None
    for sha in git("rev-list", "--no-merges", base() + "..prs").splitlines():
        if git("branch", "--list", "extra/*", "--contains", sha):
            continue
        files = [f for f in git("show", "--name-only", "--format=", sha).splitlines() if f]
        if files and all(f.startswith(TRACKING) for f in files):
            continue
        ids = extra_patch_ids() if ids is None else ids
        if patch_id(sha) in ids:
            continue
        out.append(sha[:7] + " " + git("show", "-s", "--format=%s", sha))
    return out


RELEASE_MARK = "own-release:"   # the first word of every tag message this tool writes; Artekka's start with "release:"


def release_tags():
    """Our release tags, newest first (Artekka's tags share the fork, so the message marks ours)."""
    out = []
    for line in git("for-each-ref", "refs/tags", "--sort=-v:refname", "--format=%(refname:short) %(contents:subject)").splitlines():
        name, _, subject = line.partition(" ")
        if subject.startswith(RELEASE_MARK) and re.match(r"^v\d+\.\d+\.\d+$", name):
            out.append(name)
    return out


def release_due():
    """True until the newest release tag sits exactly at prs."""
    tags = release_tags()
    return (not tags) or git("rev-parse", tags[0] + "^{commit}") != git("rev-parse", "prs")


def next_release_tag(bump="patch"):
    tags = release_tags()
    if not tags:
        return "v1.0.0"
    a, b, c = (int(x) for x in tags[0][1:].split("."))
    if bump == "major":
        a, b, c = a + 1, 0, 0
    elif bump == "minor":
        b, c = b + 1, 0
    else:
        c += 1
    return "v%d.%d.%d" % (a, b, c)


def fork_repo():
    """owner/name of the fork, from the origin remote's URL (never written into this tool)."""
    url = git("remote", "get-url", ORIGIN, check=False)
    m = re.search(r"github\.com[:/]([^/]+/[^/\s]+?)(?:\.git)?$", url)
    return m.group(1) if m else ""


def release_notes(tag, extras):
    kit = version("prs")
    live = listed(extras)
    lines = ["Orca-kit %s: Artekka's orchestration kit %s plus %d extra%s." % (tag, kit, len(live), "" if len(live) == 1 else "s"), ""]
    for e in live:
        lines.append("- **%s**: %s" % (e.get("name", e["id"]), e.get("what", "")))
    lines += ["", "Install: `claude plugin marketplace add <this repository>` then `claude plugin install orchestration-kit@artekka-kits`.",
              "The extras' own notes are in CHANGELOG.md under Unreleased; everything else is Artekka's kit as released."]
    return "\n".join(lines) + "\n"


def extras_table(extras):
    rows = ["| Extra | What it does |", "|---|---|"]
    for e in listed(extras):
        rows.append("| %s | %s |" % (e.get("name", e["id"]).replace("|", "\\|"), e.get("what", "").replace("|", "\\|")))
    return "\n".join(rows)


def readme_top(tag, extras):
    n = len(listed(extras))
    return "\n".join([
        TOP_A,
        "**This is PRS's fork of Artekka's orchestration kit.** It is his kit, kept current with his releases, plus the",
        "extras in the table below: things built while running it on real projects, kept as separate branches and offered",
        "to him one at a time. Install this fork to get all of them. The official release is **%s**, on Artekka's %s;" % (tag, version("prs")),
        "releases are on the Releases page, and this fork's changelog is at the end of this file (%d extra%s)." % (n, "" if n == 1 else "s"),
        "",
        extras_table(extras),
        TOP_Z])


def readme_names_at(ref):
    """The extra names the README's table carried at a ref (empty when it had no block)."""
    text = git("show", "%s:README.md" % ref, check=False)
    if TOP_A not in text:
        return set()
    block = text.split(TOP_A, 1)[1].split(TOP_Z, 1)[0]
    return set(m.group(1).strip() for m in re.finditer(r"^\| ([^|]+) \| ", block, re.M)) - {"Extra"}


def readme_log_entry(tag, prev, extras):
    kit = version("prs")
    now = set(e.get("name", e["id"]) for e in listed(extras))
    head = "### %s (%s)" % (tag, time.strftime("%Y-%m-%d"))
    if not prev:
        return head + "\nFirst official release: Artekka's %s plus %d extras." % (kit, len(now))
    old_kit = version(prev)
    before = readme_names_at(prev)
    parts = ["Artekka's kit %s → %s." % (old_kit, kit) if old_kit != kit else "Artekka's kit still %s." % kit]
    added, gone = sorted(now - before), sorted(before - now)
    if added:
        parts.append("New extras: " + ", ".join(added) + ".")
    if gone:
        parts.append("Extras given to his kit or retired: " + ", ".join(gone) + ".")
    if not added and not gone:
        parts.append("Extras refitted; %d in the kit." % len(now))
    return head + "\n" + " ".join(parts)


def update_readme(tag, extras, dry):
    """Rewrite the fork's README blocks on the readme extra's branch and merge it into prs; returns a report line."""
    br = "extra/" + README_EXTRA
    if not git("rev-parse", "--verify", "-q", br, check=False):
        return "README: no branch %s, left as it is" % br
    prev = release_tags()[0] if release_tags() else ""
    entry = readme_log_entry(tag, prev, extras)
    if dry:
        return "rewrite README's top block and add this changelog entry on %s, then merge it into prs:\n    %s" % (br, entry.replace("\n", "\n    "))
    import tempfile
    wt = tempfile.mkdtemp(prefix="my-extras-readme-")
    git("worktree", "add", "-q", wt, br)
    try:
        path = os.path.join(wt, "README.md")
        text = open(path, encoding="utf-8").read()
        if TOP_A not in text or TOP_Z not in text or LOG_A not in text or LOG_Z not in text:
            raise SystemExit("release refused: README.md on %s lacks the own-fork markers (%s … %s and %s … %s)" % (br, TOP_A, TOP_Z, LOG_A, LOG_Z))
        pre, rest = text.split(TOP_A, 1)
        _, post = rest.split(TOP_Z, 1)
        text = pre + readme_top(tag, extras) + post
        pre, rest = text.split(LOG_A, 1)
        block, post = rest.split(LOG_Z, 1)
        block = re.sub(r"\n### %s \(.*?\)\n.*?(?=\n### |\n?$)" % re.escape(tag), "", block, flags=re.S)   # same tag again: replace
        m = re.search(r"^### ", block, re.M)
        block = (block[:m.start()] + entry + "\n\n" + block[m.start():]) if m else (block.rstrip("\n") + "\n\n" + entry + "\n")
        text = pre + LOG_A + block + LOG_Z + post
        open(path, "w", encoding="utf-8").write(text)
        changed = bool(subprocess.run(["git", "-C", wt, "status", "--porcelain", "README.md"], capture_output=True, text=True).stdout.strip())
        if changed:   # a release stopped at a red gate already wrote this; then there is nothing new to commit
            subprocess.run(["git", "-C", wt, "add", "README.md"], check=True)
            subprocess.run(["git", "-C", wt, "commit", "-q", "-m", "readme: %s" % tag], check=True)
    finally:
        git("worktree", "remove", "--force", wt, check=False)
    if git("merge-base", "--is-ancestor", br, "prs", check=False) == "" and subprocess.run(["git", "-C", REPO, "merge-base", "--is-ancestor", br, "prs"]).returncode == 0:
        return "README already current on %s for %s" % (br, tag)
    git("merge", "--no-ff", "-q", br, "-m", "Merge %s: README for %s" % (br, tag))
    return "README rewritten on %s for %s and merged into prs" % (br, tag)


def cmd_release(dry, bump="patch"):
    if not NO_NET:
        for remote in (UP.split("/")[0], ORIGIN):
            r = subprocess.run(["timeout", "20", "git", "-C", REPO, "fetch", "-q", "--tags", remote], capture_output=True, text=True)
            if r.returncode != 0:
                raise SystemExit("release: cannot fetch %s (%s): no release without a fresh look at it" % (remote, r.stderr.strip()[:120]))
    ahead = int(git("rev-list", "--count", "prs.." + UP) or 0)
    if ahead:
        raise SystemExit("release refused: Artekka has %d new commit%s your kit lacks. Run the update first (ask Claude \"update the kit\")." % (ahead, "" if ahead == 1 else "s"))
    if git("status", "--porcelain", "--untracked-files=no"):
        raise SystemExit("release refused: the kit folder has uncommitted changes. Commit or drop them first.")
    stray = stray_commits()
    if stray:
        raise SystemExit("release refused: prs holds changes that belong to no extra:\n  " + "\n  ".join(stray))
    if not release_due():
        raise SystemExit("release refused: prs is already released as %s; nothing new since." % release_tags()[0])
    tag = next_release_tag(bump)
    if git("tag", "-l", tag):
        raise SystemExit("release refused: a tag %s already exists on this repository (Artekka's?). Pick --minor or --major, or rename." % tag)
    sha = git("rev-parse", "--short", "prs")
    extras, _ = read_page()
    notes = release_notes(tag, extras)
    import tempfile
    nf = tempfile.NamedTemporaryFile("w", suffix=".md", delete=False)
    nf.write(notes); nf.close()
    scan = subprocess.run([os.path.join(HERE, "push-check"), "file", nf.name], capture_output=True, text=True)
    if scan.returncode != 0:
        os.unlink(nf.name)
        raise SystemExit("release refused: the release notes hold a private word (fix the extra's description in MY-EXTRAS.md):\n" + scan.stdout.strip())
    repo = fork_repo()
    old = git("rev-parse", "--verify", "-q", "%s/%s" % (ORIGIN, OFFICIAL), check=False)
    plan = [update_readme(tag, extras, True),
            "tag prs (%s) as %s" % (sha, tag),
            "push prs to %s" % ORIGIN,
            "overwrite %s/%s with prs (force-with-lease; it held %s)" % (ORIGIN, OFFICIAL, old[:7] if old else "nothing"),
            "push the tag %s" % tag,
            "make the GitHub Release page %s on %s" % (tag, repo or "(no GitHub origin: skipped)")]
    if dry:
        print("release (dry run) would, after a green gate `%s`:" % GATE)
        for p in plan:
            print("  " + p)
        print("Release notes:")
        print("  " + notes.replace("\n", "\n  ").rstrip())
        os.unlink(nf.name)
        return
    print("  " + update_readme(tag, extras, False))
    sha = git("rev-parse", "--short", "prs")
    plan[1] = "tag prs (%s) as %s" % (sha, tag)
    print("gate: " + GATE)
    r = subprocess.run(GATE, shell=True, cwd=REPO, capture_output=True, text=True)
    if r.returncode != 0:
        tail = "\n".join((r.stdout + r.stderr).splitlines()[-12:])
        raise SystemExit("release refused: the gate is red (exit %d). Last lines:\n%s" % (r.returncode, tail))
    git("tag", "-a", tag, "prs", "-m", "%s Orca-kit %s on Artekka's kit %s, plus the extras listed in MY-EXTRAS.md" % (RELEASE_MARK, tag, version("prs")))
    git("push", ORIGIN, "prs")
    if git("rev-parse", "--verify", "-q", "extra/" + README_EXTRA, check=False):
        git("push", ORIGIN, "extra/" + README_EXTRA)   # the README commits live on that branch: back it up with prs
    lease = "--force-with-lease=%s:%s" % (OFFICIAL, old) if old else "--force-with-lease"
    git("push", lease, ORIGIN, "prs:refs/heads/" + OFFICIAL)
    git("push", ORIGIN, "refs/tags/" + tag)
    page = "skipped (no network)" if NO_NET else "skipped (origin is not on GitHub)" if not repo else ""
    if not page:
        r = subprocess.run(["timeout", "60", "gh", "release", "create", tag, "--repo", repo, "--title",
                            "Orca-kit %s, on Artekka's %s" % (tag, version("prs")), "--notes-file", nf.name],
                           capture_output=True, text=True)
        page = r.stdout.strip() if r.returncode == 0 else "FAILED (%s); the tag is pushed, so run: gh release create %s --repo %s --notes-file <notes>" % (r.stderr.strip()[:160], tag, repo)
    os.unlink(nf.name)
    plan[-1] += ": " + page
    for p in plan[1:]:
        print("  done: " + p)
    print("released %s: %s/%s is now prs at %s." % (tag, ORIGIN, OFFICIAL, sha))


def gh_state(pr):
    if NO_NET or not pr.isdigit():
        return None
    r = subprocess.run(["timeout", "10", "gh", "pr", "view", pr, "--repo", GH_REPO, "--json", "state,reviewDecision"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    d = json.loads(r.stdout)
    if d.get("state") == "MERGED":
        return "Merged"
    if d.get("state") == "CLOSED":
        return "Turned down"
    return "Changes asked" if d.get("reviewDecision") == "CHANGES_REQUESTED" else "Sent"


def render(extras, history, changed):
    rows = ["| Extra | What it does | Status | Pull request |", "|---|---|---|---|"]
    for e in extras:
        st = e.get("status", "Only mine")
        if needs_refit(e["id"], changed):
            st += ", needs refit"
        pr = e.get("pr", "")
        prc = "#%s" % pr if pr.isdigit() else "—"
        rows.append("| %s | %s | %s | %s |" % (e.get("name", e["id"]), e.get("what", ""), st, prc))
    lines = [
        "# My extras",
        "",
        "Your additions on top of your friend's kit. Each one is kept separately (branch `extra/<id>`), so it",
        "can be sent to him on its own, or kept only for you. The table is rewritten by",
        "`my-extras/my-extras refresh` (the start word runs it once a day); edit the Details below, not the table.",
        "",
        "Kit: Orca-kit %s + your extras · his latest: %s · updated %s" % (version(base()), version(UP), time.strftime("%Y-%m-%d")),
        "",
    ] + rows + ["", "Statuses: " + " · ".join(STATUSES) + "; \"needs refit\" = his newer version changed files this extra uses.", "", "## Details", ""]
    for e in extras:
        lines.append("### " + e["id"])
        for k in ("name", "status", "pr", "what"):
            lines.append("- %s: %s" % (k, e.get(k, "")))
        lines.append("- files (from git): " + (" ".join(extra_files(e["id"])) or "(branch missing)"))
        for k, v in e.items():  # any other line (e.g. merge notes) is kept as written
            if k not in ("id", "name", "status", "pr", "what"):
                lines.append("- %s: %s" % (k, v))
        lines.append("")
    lines += ["## Given to his kit", ""] + (["- " + h for h in history] or ["(none yet)"]) + [""]
    with open(PAGE, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))


def live(extras):
    return [e for e in extras if e.get("status") != "Merged"]


def in_kit(extras):
    return [e for e in extras if e.get("status") in ("Only mine", "Sent", "Changes asked")]


def listed(extras):
    """The extras a visitor is told about: in the kit, minus the README extra (it describes the list itself)."""
    return [e for e in in_kit(extras) if e["id"] != README_EXTRA]


def warn(text):
    """Bold yellow, so a waiting update stands out in the menu; plain when NO_COLOR is set."""
    return text if os.environ.get("NO_COLOR") else "\033[1;33m%s\033[0m" % text


def good(text):
    """Green: the installed kit is his current one; plain when NO_COLOR is set."""
    return text if os.environ.get("NO_COLOR") else "\033[32m%s\033[0m" % text


def cmd_header():
    fetch()
    extras, _ = read_page()
    n = len(in_kit(extras))
    mine = version(base())
    line = "Orca-kit %s + %d extra%s   /   " % (mine, n, "" if n == 1 else "s")
    ahead = int(git("rev-list", "--count", "prs.." + UP) or 0)
    if ahead:
        nv = version(UP)
        line += warn("▲ current %s (news)" % nv if nv != mine else "▲ current %s + new changes (news)" % nv)
    else:
        line += good("current %s ✓" % mine)
    stray = stray_commits()
    if stray:
        line += "   " + warn("⚠ %d unlisted change%s" % (len(stray), "" if len(stray) == 1 else "s"))
    print(line)
    sys.stdout.flush()
    if stamp_old("my-extras-refresh") and not NO_NET:
        # pull-request states can take seconds: refresh the page in the background, never in the menu's way
        subprocess.Popen([os.path.realpath(__file__), "refresh"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_news():
    fetch()
    extras, _ = read_page()
    b = base()
    ahead = git("rev-list", "--count", "prs.." + UP)
    print("Installed: Orca-kit %s + %d extras.  His latest: %s (%s new commit%s)." %
          (version(b), len(in_kit(extras)), version(UP), ahead, "" if ahead == "1" else "s"))
    if ahead != "0":
        heads = [l[1:].strip() for l in git("diff", b, UP, "--", "CHANGELOG.md").splitlines()
                 if l.startswith("+## ") or l.startswith("+- **")]
        if heads:
            print("What's new (his CHANGELOG):")
            for h in heads[:15]:
                print("  " + re.sub(r"\*\*", "", h)[:150])
        changed = upstream_changed()
        print("Your extras:")
        for e in live(extras):
            hit = needs_refit(e["id"], changed)
            if hit:
                print("  %s needs a refit (he changed %s)" % (e.get("name", e["id"]), ", ".join(hit[:4])))
            else:
                print("  %s: not affected" % e.get("name", e["id"]))
        print('To update: ask Claude "update the kit".')
    else:
        print("Nothing new from him.")
    stray = stray_commits()
    if stray:
        print("⚠ Changes on prs that belong to no extra:")
        for s in stray:
            print("  " + s)
    tags = release_tags()
    print("Official version: %s." % (tags[0] if tags else "none yet (my-extras/my-extras release)"))


def cmd_status():
    extras, history = read_page()
    changed = upstream_changed()
    for e in extras:
        st = e.get("status", "")
        if needs_refit(e["id"], changed):
            st += ", needs refit"
        print("%-14s %-24s %s" % (e["id"], st, ("#" + e["pr"]) if e.get("pr", "").isdigit() else ""))
    for h in history:
        print("given: " + h)


def refresh(fetch_now=True):
    if fetch_now:
        fetch(force=True)
    extras, history = read_page()
    if not extras and not os.path.exists(PAGE):
        raise SystemExit("my-extras: no MY-EXTRAS.md in " + REPO)
    for e in extras:
        if e.get("status") in ("Sent", "Changes asked"):
            st = gh_state(e.get("pr", ""))
            if st == "Turned down":
                e["status"] = "Only mine"
                e["what"] = e.get("what", "") + " (he turned down #%s)" % e.get("pr")
                e["pr"] = ""
            elif st:
                e["status"] = st
    render(extras, history, upstream_changed())
    if not NO_NET:
        touch("my-extras-refresh")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "header":
        cmd_header()
    elif cmd == "news":
        cmd_news()
    elif cmd == "status":
        cmd_status()
    elif cmd == "check":
        stray = stray_commits()
        for s in stray:
            print("unlisted: " + s)
        sys.exit(1 if stray else 0)
    elif cmd == "refresh":
        refresh()
        print("MY-EXTRAS.md refreshed")
    elif cmd == "files" and len(sys.argv) > 2:
        print("\n".join(extra_files(sys.argv[2])))
    elif cmd == "release":
        flags = sys.argv[2:]
        cmd_release("--dry-run" in flags, "major" if "--major" in flags else "minor" if "--minor" in flags else "patch")
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(64)


if __name__ == "__main__":
    main()
