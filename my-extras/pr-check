#!/usr/bin/env bash
# pr-check — run before ANY extra is sent to Artekka as a pull request (branch `miles` only, never sent).
#
# Usage: my-extras/pr-check <id>      checks branch extra/<id>; exit 0 = fit to send, 1 = refused, 64 = usage
# Refuses when the branch:
#   - does not contain upstream/main (his newer kit): refit it first
#   - holds a merge, or any commit that is on miles but not its own (another extra or miles leaking in)
#   - touches this tool's files (my-extras/, tests/my-extras.test.sh) or MY-EXTRAS.md / CLAUDE.local.md
#   - mentions anything personal (private project names, folders, the start word Miles picked)
# On success it prints the size line Miles says yes or no to, e.g. "Tabs: 3 files, +140 -2 lines", and the files.
# Env: MY_EXTRAS_REPO (default this script's repo), MY_EXTRAS_UPSTREAM (default upstream/main),
#      MY_EXTRAS_WORDS (default ~/.orchestration-kit/personal-words: the private names, kept out of the kit).
set -uo pipefail
REPO="${MY_EXTRAS_REPO:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
UP="${MY_EXTRAS_UPSTREAM:-upstream/main}"
id="${1:-}"; [ -n "$id" ] || { sed -n '4,11p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 64; }
br="extra/$id"
g() { git -C "$REPO" "$@"; }
bad=0; say() { echo "REFUSED: $*"; bad=1; }

g rev-parse --verify -q "$br" >/dev/null || { echo "REFUSED: no branch $br"; exit 1; }
g merge-base --is-ancestor "$UP" "$br" || say "$br does not contain $UP (his newer kit): refit it first"
[ -z "$(g rev-list --merges "$UP..$br")" ] || say "$br holds a merge commit; an extra is plain commits on top of his kit"
files="$(g diff --name-only "$UP...$br")"
[ -n "$files" ] || say "$br changes nothing"
while IFS= read -r f; do
  case "$f" in my-extras/*|tests/my-extras.test.sh|MY-EXTRAS.md|CLAUDE.local.md) say "$br touches a private file: $f" ;; esac
done <<<"$files"
# Commits on this branch that miles got from somewhere else than this branch = something leaked in.
for other in $(g for-each-ref --format='%(refname:short)' 'refs/heads/extra/*'); do
  [ "$other" = "$br" ] && continue
  shared="$(g rev-list "$UP..$br" --not "$UP" | while read -r c; do g merge-base --is-ancestor "$c" "$other" && echo "$c"; done)"
  [ -z "$shared" ] || say "$br shares commits with $other: send one extra at a time"
done
# Personal content: never in a public pull request.
# The words live outside the kit (it is public): one extended regex per line, # = comment.
WORDS="${MY_EXTRAS_WORDS:-$HOME/.orchestration-kit/personal-words}"
if [ -r "$WORDS" ]; then
  PERSONAL="$(grep -v '^[[:space:]]*\(#\|$\)' "$WORDS" | paste -sd'|')"
  hits="$([ -z "$PERSONAL" ] || g diff "$UP...$br" | grep '^+' | grep -inE "$PERSONAL" | head -5)"
  [ -z "$hits" ] || say "personal names in the diff:
$hits"
else
  say "no private word list at $WORDS (one pattern per line): cannot check for personal names"
fi

[ "$bad" -eq 0 ] || exit 1
read -r add del <<<"$(g diff --numstat "$UP...$br" | awk '{a+=$1; d+=$2} END {print a+0, d+0}')"
n="$(printf '%s\n' "$files" | grep -c .)"
echo "$id: $n file$([ "$n" = 1 ] || echo s), +$add -$del lines, only $br's own changes"
printf '%s\n' "$files" | sed 's/^/  /'
